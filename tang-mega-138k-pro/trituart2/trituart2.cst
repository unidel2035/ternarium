// Tang Mega 138K Pro — trituart2 (двухканальный UART)
// TODO: tx_b/rx_b пины 2x20 PinHeader — уточнить по schematic
IO_LOC "clk"     P16;
IO_LOC "tx_a"    P15;
IO_LOC "rx_a"    R15;     // TODO: verify
IO_LOC "tx_b"    V22;     // TODO: PinHeader pin
IO_LOC "rx_b"    U22;     // TODO: PinHeader pin
IO_LOC "leds[5]" N23;
IO_LOC "leds[4]" N21;
IO_LOC "leds[3]" M25;
IO_LOC "leds[2]" L20;
IO_LOC "leds[1]" R26;
IO_LOC "leds[0]" J14;

IO_PORT "clk"     IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tx_a"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "rx_a"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "tx_b"    IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "rx_b"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "leds[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "leds[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "leds[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "leds[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "leds[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
