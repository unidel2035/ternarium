// golden
function signed [31:0] golden; input integer k; begin case(k)
  0: golden=4;
  1: golden=-2;
  2: golden=0;
  3: golden=1;
  4: golden=-5;
  5: golden=-3;
  6: golden=-3;
  7: golden=1;
  default: golden=0; endcase end endfunction
